---
const tiles = [
    {
        src: "/photos/mahwiz-motorcycle.jpeg",
        alt: "Mahwiz wearing a helmet beside a motorcycle",
        position: "50% 34%",
        size: "wide"
    },
    {
        src: "/photos/mahwiz-at-cisco.jpeg",
        alt: "Mahwiz at a technology event",
        position: "40% 62%",
        size: "bottom"
    },
    {
        src: "/photos/mahwiz-outdoors.jpeg",
        alt: "Mahwiz in a green shirt outdoors at sunset",
        position: "50% 50%",
        size: "small"
    },
    {
        src: "/photos/mahwiz-portrait.jpeg",
        alt: "Mahwiz wearing a blue shirt",
        position: "50% 44%",
        size: "tall"
    }
];
---

<section class="image-grid">
    {
        tiles.map((tile) => (
            <article class={`card image-tile image-tile-${tile.size} overflow-hidden p-0`}>
                <img
                    src={tile.src}
                    alt={tile.alt}
                    loading="lazy"
                    class="h-full w-full object-cover"
                    style={`object-position: ${tile.position}`}
                />
            </article>
        ))
    }
</section>

<style>
    .image-grid {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, .65fr) minmax(0, .9fr);
        grid-template-rows: 12.5rem 22rem;
        grid-template-areas:
            "wide wide tall"
            "bottom small tall";
        gap: 1rem;
        padding-bottom: 3rem;
    }

    .image-tile {
        min-height: 0;
        min-width: 0;
        height: 100%;
        border-radius: 1.25rem;
    }

    .image-tile-wide { grid-area: wide; }
    .image-tile-bottom {
        grid-area: bottom;
        margin-top: 1.75rem;
        height: calc(100% + 1.25rem);
    }
    .image-tile-tall { grid-area: tall; }
    .image-tile-small { grid-area: small; }

    .image-tile img {
        border-radius: 0;
    }

    @media (max-width: 640px) {
        .image-grid {
            grid-template-columns: minmax(0, 2.5fr) minmax(0, .6fr) minmax(0, 1.05fr);
            grid-template-rows: 9rem 16.5rem;
            gap: .65rem;
            padding-bottom: 2rem;
        }

        .image-tile-bottom {
            margin-top: 1.1rem;
            height: calc(100% + .9rem);
        }

        .image-tile {
            border-radius: .9rem;
        }
    }
</style>
