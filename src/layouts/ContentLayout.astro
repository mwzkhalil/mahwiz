---
import Head from "@components/layout/Head.astro";
import NavBar from "@components/layout/NavBar.astro";
import Logo from "@components/layout/Logo.astro";
import { personSchema } from "@utils/schema";
import { site } from "@data/site";

interface Props {
    title: string;
    description: string;
    contentType: "Projects" | "Blogs";
    contentPath?: string;
    ogImage?: string;
    schemaType?: "Article" | "CreativeWork" | "SoftwareApplication" | "WebApplication";
    appUrl?: string;
    repoUrl?: string;
    createdAt: Date;
    updatedAt: Date;
    wide?: boolean;
}

const {
    title,
    description,
    contentType,
    contentPath,
    ogImage,
    schemaType,
    appUrl,
    repoUrl,
    createdAt,
    updatedAt,
    wide = false
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const contentUrl = new URL(contentPath ?? contentType.toLocaleLowerCase() + "/", Astro.site);
const ogImageUrl = new URL(ogImage ?? site.defaultOgImage, Astro.site).toString();
const resolvedSchemaType = schemaType ?? (contentType === "Projects" ? "CreativeWork" : "Article");
const isArticle = resolvedSchemaType === "Article";
const author = personSchema(Astro.site);

const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: contentType, item: contentUrl },
        { "@type": "ListItem", position: 2, name: title, item: pageUrl }
    ]
};

const contentStructuredData = isArticle
    ? {
          "@context": "https://schema.org",
          "@type": "Article",
          headline: title,
          description,
          datePublished: createdAt.toISOString(),
          dateModified: updatedAt.toISOString(),
          image: [ogImageUrl],
          mainEntityOfPage: pageUrl,
          author,
          publisher: author
      }
    : {
          "@context": "https://schema.org",
          "@type": resolvedSchemaType,
          name: title,
          description,
          image: [ogImageUrl],
          url: appUrl ?? pageUrl,
          mainEntityOfPage: pageUrl,
          applicationCategory: "DeveloperApplication",
          operatingSystem: "Web",
          creator: author,
          author,
          codeRepository: repoUrl,
          sameAs: appUrl ? [appUrl] : undefined
      };
---

<html lang="en">
    <head>
        <Head
            title={title}
            description={description}
            ogImage={ogImage}
            ogType={isArticle ? "article" : "website"}
            structuredData={[breadcrumbStructuredData, contentStructuredData]}
        />
    </head>
    <body class="max-w-7xl mx-auto">
        <NavBar pathname={pageUrl.pathname}>
            <Logo />
        </NavBar>
        <main class:list={[
            "pt-16 pb-[50vh] w-11/12 md:w-3/4 mx-auto content-shell",
            wide ? "lg:w-[44rem]" : "lg:w-1/2"
        ]}>
            <slot />
        </main>
    </body>
</html>
